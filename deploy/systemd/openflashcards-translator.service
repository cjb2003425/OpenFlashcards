[Unit]
Description=OpenFlashcards local English-Chinese translator
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/torrey/sites/openflashcards
Environment=PORT=8092
Environment=DICTIONARY_PATH=/home/torrey/.local/share/cijian-vocab/ecdict.sqlite
ExecStart=/home/torrey/miniconda3/bin/python /home/torrey/sites/openflashcards/tools/translator.py
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
